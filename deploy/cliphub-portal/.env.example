# Copy to .env next to compose.yaml on the VPS. Never commit the filled copy:
# it holds the OAuth secrets.

# openssl rand -base64 32
AUTH_SECRET=
# Public origin, used by Auth.js to build OAuth callback URLs.
AUTH_URL=https://cliphub.gravityroom.app

# Google Cloud console -> Credentials -> OAuth client ID (Web application).
# Authorized redirect URI: https://cliphub.gravityroom.app/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# discord.com/developers -> OAuth2.
# Redirect: https://cliphub.gravityroom.app/api/auth/callback/discord
AUTH_DISCORD_ID=
AUTH_DISCORD_SECRET=

# provider:providerAccountId pairs allowed into /admin, comma-separated.
# Sign in once, then run `pnpm whoami` against the portal database to find it.
ADMIN_ACCOUNTS=

# The capture worker has no secret here: create it in /admin (Workers) and
# put the token it shows, once, in ZV_BRIDGE_TOKEN on the capture machine.

# Optional overrides; compose supplies the defaults shown here if these are
# left unset.
# "allowed" lets every new account use the cloud without an admin's approval.
# CLOUD_ACCESS_DEFAULT=pending
# CLOUD_KINDS=short
# MAX_ACTIVE_REQUESTS_PER_USER=3
# MAX_DAILY_SECONDS_PER_USER=5400
# MAX_QUEUED_JOBS=80
# MAX_DEMO_BYTES=734003200
# MAX_DEMO_BYTES_PER_USER=3221225472
# MAX_ARTIFACT_BYTES=1073741824
# MAX_FULL_DEMO_ARTIFACT_BYTES=8589934592
# ARTIFACT_PART_BYTES=33554432
# MIN_FREE_BYTES=10737418240
# MIN_FREE_BYTES_CLAIM=2147483648
# ARTIFACT_RETENTION_DAYS=7
# FAILED_DEMO_RETENTION_HOURS=48
# RETENTION_DAYS=30
# LEASE_SECONDS=90
# MAX_UPLOAD_BACKLOG=3
