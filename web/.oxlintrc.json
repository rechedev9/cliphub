{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "jsPlugins": ["../tools/oxlint-no-comments/plugin.mjs"],
  "plugins": ["react", "nextjs", "typescript", "unicorn"],
  "categories": {
    "correctness": "off"
  },
  "env": {
    "builtin": true
  },
  "ignorePatterns": [
    ".design-sync/",
    ".next/",
    "node_modules/",
    "next-env.d.ts"
  ],
  "rules": {
    "cliphub/no-comments": "error",
    "react/display-name": "error",
    "react/jsx-key": "error",
    "react/jsx-no-comment-textnodes": "error",
    "react/jsx-no-duplicate-props": "error",
    "react/jsx-no-target-blank": "error",
    "react/jsx-no-undef": "error",
    "react/no-children-prop": "error",
    "react/no-danger-with-children": "error",
    "react/no-direct-mutation-state": "error",
    "react/no-find-dom-node": "error",
    "react/no-is-mounted": "error",
    "react/no-render-return-value": "error",
    "react/no-string-refs": "error",
    "react/no-unescaped-entities": "error",
    "react/no-unknown-property": "error",
    "react/no-unsafe": "off",
    "react/react-in-jsx-scope": "off",
    "react/require-render-return": "error",
    "react-hooks/rules-of-hooks": "error",
    "react-hooks/exhaustive-deps": "warn",
    "@typescript-eslint/ban-ts-comment": "error",
    "no-array-constructor": "error",
    "@typescript-eslint/no-duplicate-enum-values": "error",
    "@typescript-eslint/no-empty-object-type": "error",
    "@typescript-eslint/no-explicit-any": "error",
    "@typescript-eslint/no-extra-non-null-assertion": "error",
    "@typescript-eslint/no-misused-new": "error",
    "@typescript-eslint/no-namespace": "error",
    "@typescript-eslint/no-non-null-asserted-optional-chain": "error",
    "@typescript-eslint/no-require-imports": "error",
    "@typescript-eslint/no-this-alias": "error",
    "@typescript-eslint/no-unnecessary-type-constraint": "error",
    "@typescript-eslint/no-unsafe-declaration-merging": "error",
    "@typescript-eslint/no-unsafe-function-type": "error",
    "no-unused-expressions": "error",
    "no-unused-vars": [
      "error",
      {
        "argsIgnorePattern": "^_",
        "varsIgnorePattern": "^_",
        "caughtErrorsIgnorePattern": "^_"
      }
    ],
    "@typescript-eslint/no-wrapper-object-types": "error",
    "@typescript-eslint/prefer-as-const": "error",
    "@typescript-eslint/prefer-namespace-keyword": "error",
    "@typescript-eslint/triple-slash-reference": "error",
    "no-nested-ternary": "error",
    "@typescript-eslint/no-unnecessary-type-conversion": "error",
    "@typescript-eslint/no-unnecessary-type-assertion": "off",
    "max-lines": ["error", { "max": 1000 }]
  },
  "options": {
    "typeAware": true
  },
  "overrides": [
    { "files": ["lib/api/real.ts"], "rules": { "max-lines": ["error", { "max": 1346 }] } },
    {
      "files": ["app/**", "components/**", "hooks/**", "lib/**"],
      "rules": {
        "no-restricted-globals": [
          "error",
          { "name": "fetch", "message": "Call apiFetch from web/lib/api/edition-fetch.ts: it refuses an API the running edition does not serve (web/lib/edition-routes.ts)." },
          { "name": "XMLHttpRequest", "message": "Call apiFetch from web/lib/api/edition-fetch.ts, or assertEditionServes before an upload that needs progress." }
        ]
      }
    },
    {
      "files": ["app/api/**", "lib/api/edition-fetch.ts", "lib/api/upload.ts", "lib/browser-import/upload-analysis.ts", "**/*.test.ts", "**/*.test.tsx"],
      "rules": { "no-restricted-globals": "off" }
    }
  ]
}
