{
  "name": "cliphub-content",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Owner-only content tools for the ClipHub YouTube channel, served as the cliphub-content stdio MCP server",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "mcp": "node --no-warnings src/main.ts",
    "cli": "node --no-warnings src/cli.ts",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint src",
    "test:unit": "node --no-warnings --test --test-reporter=dot \"src/**/*.test.ts\""
  },
  "dependencies": {
    "@modelcontextprotocol/client": "^2.4.0",
    "@modelcontextprotocol/server": "^2.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "typescript": "catalog:"
  }
}
