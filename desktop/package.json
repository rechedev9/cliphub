{
  "name": "cliphub-studio",
  "version": "5.36.0",
  "private": true,
  "description": "ClipHub Studio - desktop Local Studio: web UI + local HLAE/CS2 capture in one app",
  "author": "ClipHub",
  "main": "dist/entry.js",
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\" && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint src scripts",
    "test:unit": "node --no-warnings --test --test-reporter=dot \"src/**/*.test.ts\" \"src/**/*.test.mjs\" \"scripts/**/*.test.mjs\"",
    "assemble": "node scripts/assemble.mjs",
    "start": "pnpm run build && electron .",
    "dist": "node scripts/dist.mjs",
    "verify:dist-integrity": "node scripts/verify-dist-integrity.mjs"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "electron": "^45.5.0",
    "electron-builder": "^26.18.0",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "typescript": "catalog:"
  },
  "build": {
    "appId": "com.cliphub.studio",
    "npmRebuild": false,
    "productName": "ClipHub Studio",
    "artifactName": "ClipHub.Studio.Setup.${version}.${ext}",
    "directories": {
      "output": "dist-installer"
    },
    "files": [
      "dist/**/*",
      "loading.html"
    ],
    "extraResources": [
      {
        "from": "build-resources/web",
        "to": "web"
      },
      {
        "from": "build-resources/web/node_modules",
        "to": "web/node_modules"
      },
      {
        "from": "build-resources/bin",
        "to": "bin"
      },
      {
        "from": "build-resources/hlae",
        "to": "hlae"
      },
      {
        "from": "build-resources/music",
        "to": "music"
      }
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "include": "build/installer.nsh"
    }
  }
}
