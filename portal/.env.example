# Auth.js (NextAuth v5). Generate AUTH_SECRET with: openssl rand -base64 32
AUTH_SECRET=
# Required when self-hosting behind a reverse proxy (not needed on Vercel).
AUTH_TRUST_HOST=true

AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_DISCORD_ID=
AUTH_DISCORD_SECRET=

# SQLite via libsql. Local dev default is a file under ./data.
DATABASE_URL=file:./data/portal.db

# Where uploaded .dem files and delivered videos live.
UPLOAD_DIR=./data/uploads

# Matches the local orchestrator's own demo cap (700 MiB) so the portal never
# accepts a file the local pipeline would reject anyway.
MAX_DEMO_BYTES=734003200

# Comma-separated provider:providerAccountId pairs allowed into /admin, e.g.
# "google:104839...,discord:938201...". Sign in once, then run
# `pnpm whoami` to find your own value. Empty means nobody can access /admin.
ADMIN_ACCOUNTS=

# Caps protecting the single shared rendering resource (the owner's own PC).
MAX_ACTIVE_REQUESTS_PER_USER=3
MAX_DAILY_REQUESTS_PER_USER=5

# Shared secret the local bridge (cmd/zv-orchestrator, ZV_BRIDGE_TOKEN) sends
# as a Bearer token to /api/bridge/*. One static secret for one permanent
# machine — not per-device credentials. Generate with: openssl rand -hex 32
BRIDGE_SHARED_SECRET=

# Cap on one finished reel the bridge sends back (1 GiB by default).
MAX_ARTIFACT_BYTES=1073741824

# Retention. Delivered videos are deleted after RETENTION_DAYS; the request
# row stays so the submitter still sees what happened. Requests whose upload
# never completed are dropped after ABANDONED_UPLOAD_HOURS so they stop
# counting against that user's active-request cap.
RETENTION_DAYS=30
ABANDONED_UPLOAD_HOURS=24
RETENTION_SWEEP_INTERVAL_MS=3600000
