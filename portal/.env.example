# Auth.js (NextAuth v5). Generate AUTH_SECRET with: openssl rand -base64 32
AUTH_SECRET=
# Required when self-hosting behind a reverse proxy (not needed on Vercel).
AUTH_TRUST_HOST=true

AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_DISCORD_ID=
AUTH_DISCORD_SECRET=

# SQLite via libsql. Local dev default is a file under ./data.
DATABASE_URL=file:./data/portal.db

# Where uploaded .dem files and result videos live.
UPLOAD_DIR=./data/uploads

# Matches the local orchestrator's own demo cap (700 MiB) so the portal never
# accepts a file the worker would reject anyway.
MAX_DEMO_BYTES=734003200
# Bytes of distinct demos one user may have stored at a time (3 GiB). A demo
# counts while a job of that user still points at it.
MAX_DEMO_BYTES_PER_USER=3221225472

# Comma-separated provider:providerAccountId pairs allowed into /admin, e.g.
# "google:104839...,discord:938201...". Sign in once, then run
# `pnpm whoami` to find your own value. Empty means nobody can access /admin.
ADMIN_ACCOUNTS=

# Cloud capture. A new account waits for an admin ("pending") or can use it at
# once ("allowed", handy for local work). Admins are always allowed.
CLOUD_ACCESS_DEFAULT=pending
# Kinds the portal accepts: "short", later "short,full_demo".
CLOUD_KINDS=short

# Caps protecting the single capture machine. Both can be overridden per user
# in /admin: jobs in flight, and machine seconds per rolling 24 hours.
MAX_ACTIVE_REQUESTS_PER_USER=3
MAX_DAILY_SECONDS_PER_USER=5400
# Jobs waiting across all users. Past this, Studio says the cloud is full.
MAX_QUEUED_JOBS=80

# The capture worker authenticates with a token created in /admin (Workers),
# shown once. Locally, `node scripts/dev-seed.ts` prints one. It goes in
# ZV_BRIDGE_TOKEN on the worker; nothing about it is configured here.

# Result files: cap per file by kind, and the size of one upload part.
MAX_ARTIFACT_BYTES=1073741824
MAX_FULL_DEMO_ARTIFACT_BYTES=8589934592
ARTIFACT_PART_BYTES=33554432

# Below this much free space on the UPLOAD_DIR volume the portal refuses new
# jobs and demo uploads (10 GiB). Uploads in flight count as already written.
# Lower it on a small development disk.
MIN_FREE_BYTES=10737418240
# Claims are refused only under this lower floor (2 GiB): a worker that keeps
# finishing jobs is what frees the demos.
MIN_FREE_BYTES_CLAIM=2147483648

# A job returns to the queue when its worker sends no heartbeat for this long.
LEASE_SECONDS=90
# A worker holding this many jobs in uploading gets no new job until one ends.
MAX_UPLOAD_BACKLOG=3

# Retention. Results are deleted ARTIFACT_RETENTION_DAYS after upload, or 24
# hours after Studio confirmed it has them. A failed job keeps its demo for
# FAILED_DEMO_RETENTION_HOURS so an operator can retry it. Jobs whose demo
# never arrived are dropped after ABANDONED_UPLOAD_HOURS. RETENTION_DAYS only
# covers videos delivered by the old manual flow.
ARTIFACT_RETENTION_DAYS=7
FAILED_DEMO_RETENTION_HOURS=48
ABANDONED_UPLOAD_HOURS=24
RETENTION_DAYS=30
RETENTION_SWEEP_INTERVAL_MS=600000
