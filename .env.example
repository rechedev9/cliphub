ZV_HTTP_ADDR=:8080
# Required session capability for the local API: 32 random bytes as lowercase
# hex (64 chars). Every API call, read or mutation, must carry it. The
# orchestrator refuses to start without it. Generate a fresh one per launch
# (e.g. `openssl rand -hex 32`; PowerShell: `-join (1..32 | %% { '{0:x2}' -f (Get-Random -Max 256) })`).
# The packaged desktop creates its own automatically.
ZV_MUTATION_TOKEN=
# In-memory job repo + inline queue; no external services needed.
ZV_DATABASE_URL=memory
ZV_DATA_DIR=./data
ZV_WORKER_CONCURRENCY=2

# Optional media workers. Leave ZV_MEDIA_WORK_DIR unset to use temp workdirs
# that are deleted after each media task. Set it to keep workdirs for debugging.
# ZV_MEDIA_WORK_DIR=./data/work
ZV_RECORDER_PATH=
ZV_HLAE_PATH=
ZV_CS2_PATH=
ZV_RECORD_TIMEOUT=20m
ZV_COMPOSER_PATH=
ZV_FFMPEG_PATH=
ZV_COMPOSE_TIMEOUT=20m

# Optional public trend hints for the manual publication assistant. The
# deterministic schedule and reel-derived recommendations work without it.
FIRECRAWL_API_KEY=
