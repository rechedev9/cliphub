        },
        "from_scale": {
          "type": [
            "number",
            "null"
          ],
          "format": "float",
          "default": null
        },
        "from_x": {
          "type": [
            "number",
            "null"
          ],
          "format": "float",
          "default": null
        },
        "from_y": {
          "type": [
            "number",
            "null"
          ],
          "format": "float",
          "default": null
        },
        "start": {
          "type": "number",
          "format": "double"
        },
        "to_scale": {
          "type": [
            "number",
            "null"
          ],
          "format": "float",
          "default": null
