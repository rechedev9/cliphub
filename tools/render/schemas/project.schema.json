{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ProjectSpec",
  "type": "object",
  "properties": {
    "audio": {
      "type": "array",
      "default": [],
      "items": {
        "$ref": "#/$defs/AudioClipSpec"
      }
    },
    "background": {
      "type": "string",
      "default": "#07090E"
    },
    "base_dir": {
      "type": [
        "string",
        "null"
      ],
      "default": null
    },
    "bg_mood": {
      "type": [
        "string",
        "null"
      ],
      "default": null
    },
    "camera": {
      "type": "array",
      "default": [],
      "items": {
        "$ref": "#/$defs/CameraTween"
      }
    },
    "camera_shakes": {
      "type": "array",
      "default": [],
      "items": {
        "$ref": "#/$defs/CameraShake"
      }
    },
    "desk_pattern": {
      "type": "boolean",
      "default": true
    },
    "duration": {
      "type": "number",
      "format": "double"
    },
    "encoder": {
      "$ref": "#/$defs/EncoderConfig",
      "default": {
        "codec": "auto",
        "cq": 19,
        "preset": "p4"
      }
    },
    "fonts": {
      "$ref": "#/$defs/FontConfig",
      "default": {
        "display": null,
        "mono": null,
        "sans": null
      }
    },
    "fps": {
      "type": "integer",
      "format": "uint32",
      "default": 60,
      "minimum": 0
    },
    "height": {
      "type": "integer",
      "format": "uint32",
      "default": 1080,
      "minimum": 0
    },
    "layers": {
      "type": "array",
      "default": [],
      "items": {
        "$ref": "#/$defs/LayerSpec"
      }
    },
    "normalize_lufs": {
      "type": [
        "number",
        "null"
      ],
      "format": "double",
      "default": null
    },
    "vignette": {
      "type": "number",
      "format": "float",
      "default": 0.44999998807907104
    },
    "width": {
      "type": "integer",
      "format": "uint32",
      "default": 1920,
      "minimum": 0
    }
  },
  "required": [
    "duration"
  ],
  "$defs": {
    "AudioClipSpec": {
      "type": "object",
      "properties": {
        "duration": {
          "type": [
            "number",
            "null"
          ],
          "format": "double",
          "default": null
        },
        "fade_in": {
          "type": "number",
          "format": "double",
          "default": 0.0
        },
        "fade_out": {
          "type": "number",
          "format": "double",
          "default": 0.0
        },
        "media_start": {
          "type": "number",
          "format": "double",
          "default": 0.0
        },
        "src": {
          "type": "string"
        },
        "start": {
          "type": "number",
          "format": "double",
          "default": 0.0
        },
        "volume": {
          "type": "number",
          "format": "float",
          "default": 1.0
        }
      },
      "required": [
        "src"
      ]
    },
    "CameraShake": {
      "type": "object",
      "properties": {
        "amplitude_x": {
          "type": "number",
          "format": "float",
          "default": -7.0
        },
        "amplitude_y": {
          "type": "number",
          "format": "float",
          "default": 4.0
