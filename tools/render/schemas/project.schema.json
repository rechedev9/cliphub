      "required": [
        "start",
        "duration",
        "from",
        "to"
      ]
    },
    "EaseKind": {
      "type": "string",
      "enum": [
        "linear",
        "power1_in_out",
        "power2_in",
        "power2_out",
        "power3_in",
        "power3_out",
        "power3_in_out",
        "power4_in",
        "power4_out",
        "back_out",
        "elastic_out",
        "sine_in_out"
