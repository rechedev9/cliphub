{
  "name": "cliphub-hltv-harvester",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Operator tool: downloads recent HLTV demo archives for the ClipHub pro lineups index",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:unit": "node --no-warnings --test --test-reporter=dot \"src/**/*.test.ts\"",
    "start": "pnpm run build && electron .",
    "ingest": "node --no-warnings src/ingest/cli.ts"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "electron": "^45.5.0",
    "linkedom": "0.18.15",
    "typescript": "catalog:"
  }
}
